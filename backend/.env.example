# Server Configurations
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# CORS Allowed Origins (comma-separated, e.g. https://yourdomain.com,https://admin.yourdomain.com)
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database Configurations
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aphrodite_nefertum?schema=public"

# Redis Configurations
REDIS_URL="redis://localhost:6379"

# JWT Token Secret Keys
JWT_SECRET="super_secret_jwt_access_key_12345!"
JWT_REFRESH_SECRET="super_secret_jwt_refresh_key_54321!"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Razorpay Credentials
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Shiprocket Credentials
SHIPROCKET_EMAIL=your@email.com
SHIPROCKET_PASSWORD=your_shiprocket_password
SHIPROCKET_BASE_URL="https://apiv2.shiprocket.in/v1/external"
SHIPROCKET_WAREHOUSE_PINCODE=122018
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_WEBHOOK_SECRET=your_shiprocket_webhook_secret

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME="mock_cloud"
CLOUDINARY_API_KEY="1234567890"
CLOUDINARY_API_SECRET="mock_cloudinary_secret"

# Transactional Email (SMTP / Nodemailer) configurations
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="mock_smtp_user"
SMTP_PASS="mock_smtp_pass"
SMTP_FROM="Aphrodite Nefertum <noreply@aphroditenefertum.com>"
